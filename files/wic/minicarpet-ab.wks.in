part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --fixed-size 256
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfsA --align 4096 --fixed-size 4096
part --ondisk mmcblk0 --fstype=ext4 --label rootfsB --align 4096 --fixed-size 4096
part /data --ondisk mmcblk0 --fstype=ext4 --label data --align 4096 --fixed-size 6144