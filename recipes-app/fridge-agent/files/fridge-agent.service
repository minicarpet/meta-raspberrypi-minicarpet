[Unit]
Description=Fridge AI Agent
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple

User=fridge-agent
Group=fridge-agent

EnvironmentFile=-/etc/fridge-agent/fridge-agent.env
EnvironmentFile=-/data/secrets/fridge-agent.env

ExecStart=/usr/bin/fridge-agent

Restart=on-failure
RestartSec=5

WorkingDirectory=/data/fridge-agent

ReadWritePaths=/data/fridge-agent

UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

RestrictSUIDSGID=true

CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target